# ==============================================================================
# DAI — Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env.production or use with docker-compose --env-file
# ==============================================================================

# --- Application Invariants ---
ENVIRONMENT=production
DEBUG=false
APP_NAME=DAI - Personal Intelligence & Project Builder

# --- Database (PostgreSQL 16 + pgvector) ---
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=dai
POSTGRES_PASSWORD=generate_a_secure_postgres_password_here
POSTGRES_DB=dai
DATABASE_URL=postgresql+asyncpg://dai:generate_a_secure_postgres_password_here@postgres:5432/dai

# --- Redis 7 ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# --- Security & JWT Authentication ---
# Generate using: openssl rand -hex 32
SECRET_KEY=replace_with_a_64_character_hex_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Cross-Origin Resource Sharing (CORS) ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,https://your-production-domain.com

# --- AI Provider & Models ---
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-production-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Anthropic (Optional)
# ANTHROPIC_API_KEY=sk-ant-your-key
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini (Optional)
# GOOGLE_API_KEY=your-gemini-key
# GOOGLE_MODEL=gemini-2.0-flash

# --- Next.js Frontend Client (baked at build time or passed via env) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1
